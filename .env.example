# PostgreSQL Connection String
# Lokal (via docker compose up -d):
DATABASE_URL="postgresql://moneytracker:moneytracker_local_pass@localhost:5433/moneytracker"
# Produksi (Vercel + Neon/Aiven/Railway):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js Secret (buat acak dengan: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Google OAuth Credentials (dari Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI (Lokal): http://localhost:3000/api/auth/callback/google
# Authorized Redirect URI (Vercel): https://domain-anda.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Wajib true saat deploy ke Vercel / reverse proxy
AUTH_TRUST_HOST="true"
